# ¿Qué? Plantilla de variables de entorno del backend. Copiar a `.env` (que NO se versiona).
# ¿Para qué? Que nadie hardcodee credenciales y que todos sepan qué variables hacen falta.
# ¿Impacto? Sin estas variables la aplicación se niega a arrancar (se validan al iniciar).
# Los valores de este archivo son solo de ejemplo: nunca usarlos en producción.

ENVIRONMENT=development

# Base de datos de desarrollo y base de datos exclusiva de pruebas (deben ser distintas)
DATABASE_URL=postgresql://sgv_user:sgv_password@localhost:5432/sgv_db
TEST_DATABASE_URL=postgresql://sgv_user:sgv_password@localhost:5433/sgv_test

# Clave de firma de los JWT: mínimo 32 caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-use-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes permitidos por CORS (lista en formato JSON) y URL pública del frontend
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# Correo saliente (en desarrollo, Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@sgv.local
